        function updateWalkerMovement(now) {
            const dt = Math.min(0.05, (now - walker.lastTime) / 1000);
            walker.lastTime = now;

            if (walker.keys.turnL || walker.pad.turnL) walker.yaw += 1.65 * dt;
            if (walker.keys.turnR || walker.pad.turnR) walker.yaw -= 1.65 * dt;

            const fwdInput = (walker.keys.fwd || walker.pad.fwd ? 1 : 0) - (walker.keys.back || walker.pad.back ? 1 : 0);
            const strafeInput = (walker.keys.right ? 1 : 0) - (walker.keys.left ? 1 : 0);

            if (fwdInput !== 0 || strafeInput !== 0) {
                const speed = (walker.keys.sprint ? 6.5 : 3.5) * dt;
                const sinY = Math.sin(walker.yaw);
                const cosY = Math.cos(walker.yaw);
                const dxMove = (-sinY * fwdInput + cosY * strafeInput) * speed;
                const dzMove = (-cosY * fwdInput - sinY * strafeInput) * speed;

                const candX = Math.max(-12.0, Math.min(58.0, walker.bx + dxMove));
                const candZ = Math.max(-8.0, Math.min(44.5, walker.bz + dzMove));

                if (walker.by < 1.5 && hitsClosedFarmBuilding(candX, candZ)) {
                    flashFarmCollisionNotice();
                    if (!hitsClosedFarmBuilding(candX, walker.bz)) walker.bx = candX;
                    else if (!hitsClosedFarmBuilding(walker.bx, candZ)) walker.bz = candZ;
                } else {
                    walker.bx = candX;
                    walker.bz = candZ;
                }
            }

            if (walker.bz >= 5.45 && walker.bz <= 6.60 && walker.bx >= 23.45 && walker.bx <= 27.15) {
                const ratio = Math.max(0, Math.min(1, (26.95 - walker.bx) / 3.30));
                walker.by = ratio * 3.80;
            } else if (walker.by > 1.90) {
                if (walker.bx < 9.60 || walker.bx > 29.10 || walker.bz < 0.15 || walker.bz > 8.75) {
                    walker.by = 0.00;
                } else {
                    walker.by = 3.80;
                }
            } else {
                walker.by = 0.00;
            }

            const badge = document.getElementById('walk-floor-badge');
            if (badge) {
                badge.textContent = walker.by > 2.8 ? 'Étage R+1 • +3,80 m' : (walker.by > 0.25 ? `Escalier • +${walker.by.toFixed(1)} m` : (walker.bz > 9.2 ? 'Cour Intérieure Ferme • 0,00 m' : 'RDC • 0,00 m'));
            }

            const eyeY = walker.by + 1.68;
            camera.position.set(bx(walker.bx), eyeY, bz(walker.bz));
            const lookDist = 5.0;
            camera.lookAt(
                bx(walker.bx) - Math.sin(walker.yaw) * Math.cos(walker.pitch) * lookDist,
                eyeY + Math.sin(walker.pitch) * lookDist,
                bz(walker.bz) - Math.cos(walker.yaw) * Math.cos(walker.pitch) * lookDist
            );
        }

