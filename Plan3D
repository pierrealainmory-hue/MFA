        function bx(xMeters) { return xMeters - CENTER_X; }
        function bz(zMeters) { return zMeters - CENTER_Z; }

        function registerInteractive(obj, meta) {
            if (!meta) return;
            obj.traverse(child => {
                if (child.isMesh) {
                    child.material = child.material.clone();
                    child.userData = meta;
                    interactiveMeshes.push(child);
                }
            });
        }

        function addBox(parent, x, y, z, w, h, d, mat, meta, castShadow = true) {
            const geo = new THREE.BoxGeometry(w, h, d);
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(bx(x + w / 2), y + h / 2, bz(z + d / 2));
            mesh.castShadow = castShadow;
            mesh.receiveShadow = true;
            parent.add(mesh);
            if (meta) registerInteractive(mesh, meta);
            return mesh;
        }

        function addDualWall(x, z, w, d, fullH, mat, meta) {
            addBox(groups.rdcFullWalls, x, 0, z, w, fullH, d, mat, meta);
            addBox(groups.rdcLowWalls, x, 0, z, w, Math.min(1.35, fullH), d, mat, meta);
        }

        function addWindowWallSegment(x, z, w, d, sillH, winH, totalH, mat, meta) {
            if (sillH > 0.02) addDualWall(x, z, w, d, sillH, mat, null);
            addBox(groups.rdcFullWalls, x + (w > d ? 0 : 0.06), sillH, z + (d > w ? 0 : 0.06), w > d ? w : 0.08, winH, d > w ? d : 0.08, MATS.glass, meta, false);
            addBox(groups.rdcLowWalls, x + (w > d ? 0 : 0.06), sillH, z + (d > w ? 0 : 0.06), w > d ? w : 0.08, Math.max(0.15, 1.35 - sillH), d > w ? d : 0.08, MATS.glass, meta, false);
            const topY = sillH + winH;
            if (totalH > topY + 0.02) {
                addBox(groups.rdcFullWalls, x, topY, z, w, totalH - topY, d, mat, null);
            }
        }

        function add3DLabel(x, y, z, text, bgClass, layerKey = 'all') {
            const div = document.createElement('div');
            div.className = `label-3d ${bgClass}`;
            div.textContent = text;
            document.getElementById('labels-container').appendChild(div);
            labels3D.push({ pos: new THREE.Vector3(bx(x), y, bz(z)), el: div, layerKey });
        }

        // ============================================================================
