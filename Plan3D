                    sx = lerpNum(4.8, 2.35, u); sz = lerpNum(4.4, 6.15, u); syaw = 0.85;
                } else {
                    const u = smoothStep01((p - 0.70) / 0.30);
                    sx = lerpNum(2.35, 2.35, u); sz = lerpNum(6.15, 10.2, u); syaw = 3.14;
                }
                demoActors.shopper.position.set(bx(sx), 0, bz(sz));
                demoActors.shopper.rotation.y = syaw;
                demoActors.beaconRing.position.set(bx(sx), 0.08, bz(sz));

                camOrbit.desiredTarget.set(bx(lerpNum(6.2, 2.8, s)), 1.2, bz(lerpNum(4.2, 6.2, s)));
                camOrbit.desiredTheta = lerpNum(-0.25, 0.25, s);
                camOrbit.desiredPhi = 0.78;
                camOrbit.desiredRadius = 13.5;
            }
        }

        // ============================================================================
        // 6. CONTRÔLES D'INTERFACE EXPOSÉS SUR WINDOW
        // ============================================================================
        window.applyViewPreset = function (preset) {
            if (viewConfig.walkMode) window.exitWalkMode();
            if (viewConfig.demoMode) window.exitDemoTour(true);
            document.querySelectorAll('.mode-btn').forEach(b => {
                if (b.id !== 'mode-walk' && b.id !== 'mode-demo') b.classList.remove('active');
            });
            const btn = document.getElementById('mode-' + preset);
            if (btn) btn.classList.add('active');

            if (preset === 'cutaway_all') {
                viewConfig.lowWalls = false; viewConfig.showR1 = true; viewConfig.showAuvent = true; viewConfig.showRoof = false; viewConfig.showCeilings = false;
                window.flyToCamera('overview');
            } else if (preset === 'rdc_only') {
                viewConfig.lowWalls = true; viewConfig.showR1 = false; viewConfig.showAuvent = true; viewConfig.showRoof = false; viewConfig.showCeilings = false; viewConfig.showSmall = true;
                window.flyToCamera('overview');
            } else if (preset === 'r1_focus') {
                viewConfig.lowWalls = false; viewConfig.showR1 = true; viewConfig.showAuvent = false; viewConfig.showRoof = false;
                camOrbit.desiredTarget.set(bx(19.5), 4.2, bz(4.45));
                camOrbit.desiredTheta = 0.25; camOrbit.desiredPhi = 0.72; camOrbit.desiredRadius = 22.0;
            } else if (preset === 'exterior') {
                viewConfig.lowWalls = false; viewConfig.showFarm = true; viewConfig.showR1 = true; viewConfig.showAuvent = true; viewConfig.showRoof = true;
                window.flyToCamera('ferme', true);
            }
            syncLayerVisibility();
        };

        window.toggleDemoTour = function () {
            if (viewConfig.demoMode) {
                window.exitDemoTour();
                return;
            }
            if (viewConfig.walkMode) window.exitWalkMode();
            window.closeInspector();
            demoState.savedView = {
                lowWalls: viewConfig.lowWalls,
                showRoof: viewConfig.showRoof,
                showR1: viewConfig.showR1,
                showAuvent: viewConfig.showAuvent,
                showCeilings: viewConfig.showCeilings,
                showFarm: viewConfig.showFarm
            };
            viewConfig.demoMode = true;
            demoState.stepIndex = 0;
            demoState.stepElapsed = 0;
            demoState.paused = false;
            demoState.lastTick = performance.now();

            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('mode-demo').classList.add('active');
            document.getElementById('demo-hud').classList.remove('hidden');
            document.getElementById('side-controls').classList.add('hidden');
            document.getElementById('bottom-help-bar').classList.add('hidden');
            document.getElementById('btn-demo-pause').innerHTML = '<i class="fa-solid fa-pause mr-1"></i>Pause';

            resetDemoActorsToRest();
            applyDemoStepMeta(0);
        };

        window.toggleDemoMinimize = function () {
            demoState.minimized = !demoState.minimized;
            const body = document.getElementById('demo-Hud-collapsible');
            const icon = document.getElementById('demo-min-icon');
            if (body) body.classList.toggle('hidden', demoState.minimized);
            if (icon) icon.className = demoState.minimized ? 'fa-solid fa-chevron-down' : 'fa-solid fa-chevron-up';
        };

        window.exitDemoTour = function (skipPresetRestore) {
            viewConfig.demoMode = false;
            resetDemoActorsToRest();
            document.getElementById('mode-demo').classList.remove('active');
            document.getElementById('demo-hud').classList.add('hidden');
            document.getElementById('side-controls').classList.remove('hidden');
            document.getElementById('bottom-help-bar').classList.remove('hidden');
            if (!skipPresetRestore) {
                if (demoState.savedView) {
                    Object.assign(viewConfig, demoState.savedView);
                } else {
                    viewConfig.showRoof = false;
                    viewConfig.showR1 = true;
                    viewConfig.showAuvent = true;
                }
                document.getElementById('mode-cutaway_all').classList.add('active');
            }
            syncLayerVisibility();
        };

        window.setDemoStep = function (idx) {
            demoState.stepIndex = Math.max(0, Math.min(DEMO_STEPS.length - 1, idx));
            demoState.stepElapsed = 0;
            demoState.lastTick = performance.now();
            resetDemoActorsToRest();
            applyDemoStepMeta(demoState.stepIndex);
        };

        window.stepDemoDelta = function (delta) {
            const next = (demoState.stepIndex + delta + DEMO_STEPS.length) % DEMO_STEPS.length;
            window.setDemoStep(next);
        };

        window.toggleDemoPause = function () {
            demoState.paused = !demoState.paused;
            demoState.lastTick = performance.now();
            const btn = document.getElementById('btn-demo-pause');
            if (btn) {
                btn.innerHTML = demoState.paused
                    ? '<i class="fa-solid fa-play mr-1"></i>Lecture'
                    : '<i class="fa-solid fa-pause mr-1"></i>Pause';
            }
        };

        window.toggleWalkMode = function () {
            if (viewConfig.walkMode) {
                window.exitWalkMode();
                return;
            }
            if (viewConfig.demoMode) window.exitDemoTour(true);
            viewConfig.walkMode = true;
            viewConfig.showR1 = true;
            viewConfig.showAuvent = true;
            viewConfig.showRoof = true;
            viewConfig.showStaff = true;
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('mode-walk').classList.add('active');
            document.getElementById('walk-hud').classList.remove('hidden');
            document.getElementById('walk-dpad').classList.remove('hidden');
            document.getElementById('side-controls').classList.add('hidden');
            document.getElementById('orbit-nav-pad').classList.add('hidden');
            document.getElementById('bottom-help-bar').classList.add('hidden');
            walker.lastTime = performance.now();
            window.teleportWalker('boutique');
            syncLayerVisibility();
        };

        window.exitWalkMode = function () {
            viewConfig.walkMode = false;
            viewConfig.showRoof = false;
            document.getElementById('mode-walk').classList.remove('active');
            document.getElementById('mode-cutaway_all').classList.add('active');
            document.getElementById('walk-hud').classList.add('hidden');
            document.getElementById('walk-dpad').classList.add('hidden');
            document.getElementById('walk-notice').classList.add('hidden');
            document.getElementById('side-controls').classList.remove('hidden');
            document.getElementById('orbit-nav-pad').classList.remove('hidden');
            document.getElementById('bottom-help-bar').classList.remove('hidden');
            syncLayerVisibility();
        };

        window.flyToCamera = function (key, keepRoof) {
            if (viewConfig.walkMode) window.exitWalkMode();
            if (viewConfig.demoMode) window.exitDemoTour(true);
            document.querySelectorAll('.cam-btn').forEach(b => b.classList.remove('active'));
            const btn = document.getElementById('cam-' + key);
            if (btn) btn.classList.add('active');

            if (key === 'ferme') {
                viewConfig.showFarm = true;
                viewConfig.showRoof = true;
                syncLayerVisibility();
            } else if (!keepRoof && viewConfig.showRoof && key !== 'overview' && key !== 'top') {
                viewConfig.showRoof = false;
                syncLayerVisibility();
            }

            const presets = {
                overview: { tx: 0, ty: 1.8, tz: 0, theta: 0.42, phi: 0.94, r: 36.0 },
                ferme:    { tx: bx(22.0), ty: 2.2, tz: bz(23.5), theta: 0.62, phi: 0.96, r: 72.0 },
                top:      { tx: 0, ty: 0.5, tz: 0, theta: 0.00, phi: 0.14, r: 42.0 },
                boutique: { tx: bx(4.75), ty: 1.2, tz: bz(4.5), theta: -0.35, phi: 0.88, r: 14.0 },
                fournil:  { tx: bx(16.2), ty: 1.2, tz: bz(4.5), theta: 0.22, phi: 0.84, r: 16.0 },
                meunerie: { tx: bx(30.8), ty: 1.6, tz: bz(4.2), theta: 0.48, phi: 0.88, r: 17.0 },
                escalier: { tx: bx(24.8), ty: 2.0, tz: bz(6.4), theta: -0.35, phi: 1.02, r: 11.0 }
            };
            const p = presets[key] || presets.overview;
            camOrbit.desiredTarget.set(p.tx, p.ty, p.tz);
            camOrbit.desiredTheta = p.theta;
            camOrbit.desiredPhi = p.phi;
            camOrbit.desiredRadius = p.r;
        };

        window.toggleLowWalls = function () { viewConfig.lowWalls = !viewConfig.lowWalls; syncLayerVisibility(); };
        window.toggleLabels = function () { viewConfig.showLabels = !viewConfig.showLabels; syncLayerVisibility(); };
        window.toggleLayer3D = function (key) {
            if (key === 'farm') viewConfig.showFarm = !viewConfig.showFarm;
            if (key === 'small') viewConfig.showSmall = !viewConfig.showSmall;
            if (key === 'r1') viewConfig.showR1 = !viewConfig.showR1;
            if (key === 'auvent') viewConfig.showAuvent = !viewConfig.showAuvent;
            if (key === 'roof') viewConfig.showRoof = !viewConfig.showRoof;
            if (key === 'ceilings') viewConfig.showCeilings = !viewConfig.showCeilings;
            if (key === 'networks') viewConfig.showNetworks = !viewConfig.showNetworks;
            if (key === 'staff') viewConfig.showStaff = !viewConfig.showStaff;
            syncLayerVisibility();
        };
        window.toggleControlPanel = function () {
            viewConfig.panelOpen = !viewConfig.panelOpen;
            document.getElementById('panel-collapsible').classList.toggle('hidden', !viewConfig.panelOpen);
            document.getElementById('panel-chevron').className = viewConfig.panelOpen ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
        };
        window.zoomStep = function (delta) {
            camOrbit.desiredRadius = Math.max(4.5, Math.min(115.0, camOrbit.desiredRadius * (1 + delta)));
        };

        window.teleportWalker = function (spotKey) {
            const sp = TELEPORT_SPOTS[spotKey];
            if (!sp) return;
            walker.bx = sp.bx; walker.by = sp.by; walker.bz = sp.bz;
            walker.yaw = sp.yaw; walker.pitch = sp.pitch;
        };

        window.setPadMove = function (dir, active) {
            walker.pad[dir] = active;
        };

        window.rotateStep = function (delta) {
            camOrbit.desiredTheta += delta;
        };
        window.closeInspector = function () {
            if (selectedMesh && selectedMesh.material && selectedMesh.material.emissive) {
                selectedMesh.material.emissive.setHex(selectedOrigEmissive);
            }
            selectedMesh = null;
            document.getElementById('inspector-card').classList.add('hidden');
        };

        // ============================================================================
        // 7. INITIALISATION THREE.JS, GESTION RESPONSIVE & BOUCLE D'ANIMATION
        // ============================================================================
        function getSafeContainerSize(container) {
            const w = Math.max(container.clientWidth || window.innerWidth || 960, 120);
            const h = Math.max(container.clientHeight || (window.innerHeight - 56) || 600, 120);
            return { w, h };
        }

        function initScene() {
            const container = document.getElementById('canvas-container');
            const prevCanvas = container.querySelector('canvas');
            if (prevCanvas) prevCanvas.remove();
            document.getElementById('labels-container').innerHTML = '';

            const { w, h } = getSafeContainerSize(container);
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xdbeafe);
            scene.fog = new THREE.FogExp2(0xdbeafe, 0.0032);

            camera = new THREE.PerspectiveCamera(48, w / h, 0.15, 420);
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(w, h);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.appendChild(renderer.domElement);

            raycaster = new THREE.Raycaster();
            mouseVec = new THREE.Vector2();

            scene.add(new THREE.HemisphereLight(0xffffff, 0xcbd5e1, 0.74));
            const sun = new THREE.DirectionalLight(0xfffbeb, 0.92);
            sun.position.set(-18, 52, 36);
            sun.castShadow = true;
            sun.shadow.mapSize.set(2048, 2048);
            sun.shadow.camera.left = -68;
            sun.shadow.camera.right = 72;
            sun.shadow.camera.top = 68;
            sun.shadow.camera.bottom = -68;
            scene.add(sun);

            initMaterials();
            buildComplete3DModel();
            syncLayerVisibility();
            setupInputListeners(renderer.domElement, container);
        }

        function handleCanvasPick(clientX, clientY) {
            const rect = renderer.domElement.getBoundingClientRect();
            if (!rect.width || !rect.height) return;
            mouseVec.x = ((clientX - rect.left) / rect.width) * 2 - 1;
            mouseVec.y = -((clientY - rect.top) / rect.height) * 2 + 1;
            raycaster.setFromCamera(mouseVec, camera);

            const hits = raycaster.intersectObjects(interactiveMeshes, false).filter(h => {
                let p = h.object;
                while (p) { if (!p.visible) return false; p = p.parent; }
                return true;
            });

            if (hits.length > 0) {
                const hit = hits[0].object;
                if (selectedMesh && selectedMesh.material && selectedMesh.material.emissive) {
                    selectedMesh.material.emissive.setHex(selectedOrigEmissive);
                }
                selectedMesh = hit;
                if (hit.material && hit.material.emissive) {
                    selectedOrigEmissive = hit.material.emissive.getHex();
                    hit.material.emissive.setHex(0x2563eb);
                }
                const d = hit.userData;
                document.getElementById('insp-zone').textContent = d.zone || 'ÉLÉMENT';
                document.getElementById('insp-title').textContent = d.title || 'Ouvrage';
                document.getElementById('insp-desc').textContent = d.desc || '';
                document.getElementById('insp-dims').textContent = d.dims || '';
                document.getElementById('insp-lot').textContent = d.lot || '';
                document.getElementById('inspector-card').classList.remove('hidden');
            }
        }

        function setupInputListeners(domEl, container) {
            domEl.addEventListener('contextmenu', e => e.preventDefault());

            domEl.addEventListener('mousedown', e => {
                camOrbit.isDragging = true;
                camOrbit.movedDistance = 0;
                camOrbit.prevX = e.clientX;
                camOrbit.prevY = e.clientY;
                camOrbit.dragMode = (e.button === 2 || e.shiftKey) ? 'pan' : 'orbit';
            });

            const onMouseMove = e => {
                if (!camOrbit.isDragging) return;
                const dx = e.clientX - camOrbit.prevX;
                const dy = e.clientY - camOrbit.prevY;
                camOrbit.prevX = e.clientX;
                camOrbit.prevY = e.clientY;
                camOrbit.movedDistance += Math.hypot(dx, dy);

                if (viewConfig.walkMode) {
                    walker.yaw -= dx * 0.0045;
                    walker.pitch = Math.max(-0.85, Math.min(0.85, walker.pitch - dy * 0.0038));
                } else if (camOrbit.dragMode === 'orbit') {
                    camOrbit.desiredTheta -= dx * 0.0065;
                    camOrbit.desiredPhi = Math.max(0.12, Math.min(1.48, camOrbit.desiredPhi - dy * 0.0065));
                } else {
                    const panFactor = camOrbit.radius * 0.0014;
                    const right = new THREE.Vector3(Math.cos(camOrbit.theta), 0, -Math.sin(camOrbit.theta));
                    const forward = new THREE.Vector3(-Math.sin(camOrbit.theta), 0, -Math.cos(camOrbit.theta));
                    camOrbit.desiredTarget.addScaledVector(right, -dx * panFactor);
                    camOrbit.desiredTarget.addScaledVector(forward, dy * panFactor);
                }
            };

            const onMouseUp = e => {
                if (camOrbit.isDragging && camOrbit.movedDistance < 5 && e.button === 0) {
                    handleCanvasPick(e.clientX, e.clientY);
                }
                camOrbit.isDragging = false;
            };

            window.addEventListener('mousemove', onMouseMove);
            window.addEventListener('mouseup', onMouseUp);

            domEl.addEventListener('wheel', e => {
                e.preventDefault();
                if (!viewConfig.walkMode) {
                    camOrbit.desiredRadius = Math.max(4.5, Math.min(115.0, camOrbit.desiredRadius * (e.deltaY > 0 ? 1.10 : 0.90)));
                }
            }, { passive: false });

            domEl.addEventListener('touchstart', e => {
                if (e.touches.length === 1) {
                    camOrbit.isDragging = true;
                    camOrbit.movedDistance = 0;
                    camOrbit.prevX = e.touches[0].clientX;
                    camOrbit.prevY = e.touches[0].clientY;
                } else if (e.touches.length === 2) {
                    camOrbit.pinchStartDist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                }
            }, { passive: true });

            domEl.addEventListener('touchmove', e => {
                if (e.touches.length === 1 && camOrbit.isDragging) {
                    const dx = e.touches[0].clientX - camOrbit.prevX;
                    const dy = e.touches[0].clientY - camOrbit.prevY;
                    camOrbit.prevX = e.touches[0].clientX;
                    camOrbit.prevY = e.touches[0].clientY;
                    camOrbit.movedDistance += Math.hypot(dx, dy);
                    if (viewConfig.walkMode) {
                        walker.yaw -= dx * 0.005;
                        walker.pitch = Math.max(-0.8, Math.min(0.8, walker.pitch - dy * 0.004));
                    } else {
                        camOrbit.desiredTheta -= dx * 0.007;
                        camOrbit.desiredPhi = Math.max(0.14, Math.min(1.48, camOrbit.desiredPhi - dy * 0.007));
                    }
                } else if (e.touches.length === 2 && !viewConfig.walkMode) {
                    const dist = Math.hypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    if (camOrbit.pinchStartDist > 10) {
                        camOrbit.desiredRadius = Math.max(5.0, Math.min(115.0, camOrbit.desiredRadius * (camOrbit.pinchStartDist / dist)));
                    }
                    camOrbit.pinchStartDist = dist;
                }
            }, { passive: true });

            domEl.addEventListener('touchend', () => { camOrbit.isDragging = false; }, { passive: true });

            const onKeyDown = e => {
                const k = e.key.toLowerCase();
                if (k === 'z' || k === 'w' || e.key === 'ArrowUp') walker.keys.fwd = true;
                if (k === 's' || e.key === 'ArrowDown') walker.keys.back = true;
                if (k === 'q' || k === 'a') walker.keys.left = true;
                if (k === 'd') walker.keys.right = true;
                if (e.key === 'ArrowLeft') walker.keys.turnL = true;
                if (e.key === 'ArrowRight') walker.keys.turnR = true;
                if (e.key === 'Shift') walker.keys.sprint = true;
                if (e.key === 'Escape') {
                    if (viewConfig.walkMode) window.exitWalkMode();
                    if (viewConfig.demoMode) window.exitDemoTour();
                }
            };

            const onKeyUp = e => {
                const k = e.key.toLowerCase();
                if (k === 'z' || k === 'w' || e.key === 'ArrowUp') walker.keys.fwd = false;
                if (k === 's' || e.key === 'ArrowDown') walker.keys.back = false;
                if (k === 'q' || k === 'a') walker.keys.left = false;
                if (k === 'd') walker.keys.right = false;
                if (e.key === 'ArrowLeft') walker.keys.turnL = false;
                if (e.key === 'ArrowRight') walker.keys.turnR = false;
                if (e.key === 'Shift') walker.keys.sprint = false;
            };

            window.addEventListener('keydown', onKeyDown);
            window.addEventListener('keyup', onKeyUp);

            const onResize = () => {
                if (!renderer || !camera) return;
                const { w, h } = getSafeContainerSize(container);
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h);
            };
            window.addEventListener('resize', onResize);
            if (window.ResizeObserver) {
                resizeObs = new ResizeObserver(onResize);
                resizeObs.observe(container);
            }

            window.__dagny3DCleanup = function () {
                if (animFrameId) cancelAnimationFrame(animFrameId);
                if (resizeObs) resizeObs.disconnect();
                window.removeEventListener('mousemove', onMouseMove);
                window.removeEventListener('mouseup', onMouseUp);
                window.removeEventListener('keydown', onKeyDown);
                window.removeEventListener('keyup', onKeyUp);
                window.removeEventListener('resize', onResize);
            };
        }

        function updateProjectedLabels() {
            const container = document.getElementById('canvas-container');
            const w = container.clientWidth;
            const h = container.clientHeight;
            if (!w || !h) return;

            labels3D.forEach(lbl => {
                const okR1 = (lbl.layerKey !== 'r1' || viewConfig.showR1);
                const okFarm = (lbl.layerKey !== 'farm' || viewConfig.showFarm);
                const visibleLayer = viewConfig.showLabels && !viewConfig.walkMode && !viewConfig.demoMode && okR1 && okFarm;
                if (!visibleLayer) {
                    lbl.el.style.display = 'none';
                    return;
                }
                const proj = lbl.pos.clone().project(camera);
                if (proj.z > 1 || proj.z < -1) {
                    lbl.el.style.display = 'none';
                    return;
                }
                const sx = (proj.x * 0.5 + 0.5) * w;
                const sy = (-proj.y * 0.5 + 0.5) * h;
                lbl.el.style.display = 'block';
                lbl.el.style.left = `${sx}px`;
                lbl.el.style.top = `${sy}px`;
            });
        }

        function animate(now) {
            animFrameId = requestAnimationFrame(animate);
            const curNow = now || performance.now();
            const t = curNow * 0.001;

            animatedMillstones.forEach(stone => { stone.rotation.y += 0.022; });
            animatedCharacters.forEach(ch => {
                ch.arms.rotation.x = Math.sin(t * 2.4 + ch.phase) * 0.10;
            });

            if (viewConfig.walkMode) {
                updateWalkerMovement(curNow);
            } else {
                if (viewConfig.demoMode) {
                    updateDemoTourAnimation(curNow);
                }
                camOrbit.theta += (camOrbit.desiredTheta - camOrbit.theta) * 0.10;
                camOrbit.phi += (camOrbit.desiredPhi - camOrbit.phi) * 0.10;
                camOrbit.radius += (camOrbit.desiredRadius - camOrbit.radius) * 0.10;
                camOrbit.target.lerp(camOrbit.desiredTarget, 0.10);

                camera.position.set(
                    camOrbit.target.x + camOrbit.radius * Math.sin(camOrbit.phi) * Math.sin(camOrbit.theta),
                    camOrbit.target.y + camOrbit.radius * Math.cos(camOrbit.phi),
                    camOrbit.target.z + camOrbit.radius * Math.sin(camOrbit.phi) * Math.cos(camOrbit.theta)
                );
                camera.lookAt(camOrbit.target);
            }

            updateProjectedLabels();
            renderer.render(scene, camera);
        }

        let hasBooted = false;
        function boot3DApp() {
            if (hasBooted) return;
            hasBooted = true;
            try {
                initScene();
                walker.lastTime = performance.now();
                animate(performance.now());
            } catch (err) {
                const box = document.getElementById('webgl-error-box');
                const txt = document.getElementById('webgl-error-text');
                if (box && txt) {
                    txt.textContent = err && err.message ? err.message : String(err);
                    box.classList.remove('hidden');
                }
            }
        }

        window.onload = function () {
            boot3DApp();
        };
        if (document.readyState === 'complete') {
            setTimeout(boot3DApp, 0);
        }
    })();
    </script>
