        function createClosedBriardWing(x, z, w, d, wallH, ridgeH, orientAlongX, meta, customRoofMat) {
            const rMat = customRoofMat || MATS.roofTiles;
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.BoxGeometry(w, wallH, d), MATS.farmStone);
            body.position.set(bx(x + w / 2), wallH / 2, bz(z + d / 2));
            body.castShadow = true;
            body.receiveShadow = true;
            g.add(body);

            const rise = ridgeH - wallH;
            if (orientAlongX) {
                const halfD = d / 2 + 0.35;
                const slopeLen = Math.hypot(halfD, rise);
                const slopeAng = Math.atan2(rise, halfD);

                const r1 = new THREE.Mesh(new THREE.BoxGeometry(w + 0.6, 0.14, slopeLen), rMat);
                r1.position.set(bx(x + w / 2), wallH + rise / 2, bz(z + d * 0.25));
                r1.rotation.x = -slopeAng;
                r1.castShadow = true;
                g.add(r1);

                const r2 = new THREE.Mesh(new THREE.BoxGeometry(w + 0.6, 0.14, slopeLen), rMat);
                r2.position.set(bx(x + w / 2), wallH + rise / 2, bz(z + d * 0.75));
                r2.rotation.x = slopeAng;
                r2.castShadow = true;
                g.add(r2);

                const gShape = new THREE.Shape();
                gShape.moveTo(0, wallH);
                gShape.lineTo(d, wallH);
                gShape.lineTo(d / 2, ridgeH);
                gShape.closePath();
                const gGeo = new THREE.ExtrudeGeometry(gShape, { depth: 0.28, bevelEnabled: false });
                gGeo.rotateY(-Math.PI / 2);
                [x + 0.28, x + w].forEach(gx => {
                    const gm = new THREE.Mesh(gGeo, MATS.farmStone);
                    gm.position.set(bx(gx), 0, bz(z));
                    g.add(gm);
                });
            } else {
                const halfW = w / 2 + 0.35;
                const slopeLen = Math.hypot(halfW, rise);
                const slopeAng = Math.atan2(rise, halfW);

                const r1 = new THREE.Mesh(new THREE.BoxGeometry(slopeLen, 0.14, d + 0.6), rMat);
                r1.position.set(bx(x + w * 0.25), wallH + rise / 2, bz(z + d / 2));
                r1.rotation.z = slopeAng;
                r1.castShadow = true;
                g.add(r1);

                const r2 = new THREE.Mesh(new THREE.BoxGeometry(slopeLen, 0.14, d + 0.6), rMat);
                r2.position.set(bx(x + w * 0.75), wallH + rise / 2, bz(z + d / 2));
                r2.rotation.z = -slopeAng;
                r2.castShadow = true;
                g.add(r2);

                const gShape = new THREE.Shape();
                gShape.moveTo(0, wallH);
                gShape.lineTo(w, wallH);
                gShape.lineTo(w / 2, ridgeH);
                gShape.closePath();
                const gGeo = new THREE.ExtrudeGeometry(gShape, { depth: 0.28, bevelEnabled: false });
                [z, z + d - 0.28].forEach(gz => {
                    const gm = new THREE.Mesh(gGeo, MATS.farmStone);
                    gm.position.set(bx(x), 0, bz(gz));
                    g.add(gm);
                });
            }

            groups.farmComplex.add(g);
            if (meta) registerInteractive(g, meta);
            return g;
        }

