<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maquette 3D Interactive — Meunerie & Fournil de l'Aubetin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #0f172a;
            user-select: none;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        #canvas-container {
            position: relative;
            width: 100%;
            flex: 1 1 0%;
            min-height: 0;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            cursor: grab;
        }
        canvas:active {
            cursor: grabbing;
        }

        .label-3d {
            position: absolute;
            transform: translate(-50%, -100%);
            pointer-events: none;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.35);
            border: 1.5px solid rgba(255, 255, 255, 0.85);
            transition: opacity 0.15s ease;
            z-index: 15;
        }

        .mode-btn.active {
            background-color: #f59e0b !important;
            color: #0f172a !important;
            border-color: #fbbf24 !important;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
        }

        .cam-btn.active {
            background-color: #2563eb !important;
            color: #ffffff !important;
            border-color: #3b82f6 !important;
        }

        .layer-pill.active {
            background-color: #0f172a !important;
            color: #ffffff !important;
            border-color: #334155 !important;
        }

        .demo-step-btn.active {
            background-color: #f59e0b !important;
            color: #0f172a !important;
            border-color: #fde68a !important;
            font-weight: 800 !important;
        }
    </style>
</head>
<body class="text-slate-800">

    <!-- BARRE D'EN-TÊTE PRINCIPALE -->
    <header class="min-h-[54px] py-1.5 bg-slate-900 text-white px-3 sm:px-4 flex flex-wrap items-center justify-between border-b border-slate-800 gap-2 z-30 relative shrink-0">
        <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-400 shrink-0">
                <i class="fa-solid fa-cube"></i>
            </div>
            <div class="truncate">
                <div class="text-xs sm:text-sm font-extrabold tracking-wide flex items-center gap-2">
                    <span class="truncate">MEUNERIE & FOURNIL DE L'AUBETIN</span>
                    <span class="hidden lg:inline-block text-[10px] bg-amber-500/20 text-amber-300 border border-amber-400/40 px-2 py-0.5 rounded-full font-bold">Corps de Ferme • Produits & Stocks • Démo 3D</span>
                </div>
                <div class="text-[10px] text-slate-400 hidden sm:block truncate">
                    1, Ferme d'Aubetin – 77320 Dagny (Bâtiment d'angle ouvert sur la cour intérieure) • RDC (341 m²) + R+1 (172 m²)
                </div>
            </div>
        </div>

        <!-- Sélecteur de Mode d'Écorché 3D, Visite à Pied & Visite Démo Guidée -->
        <div class="flex items-center gap-1 bg-slate-800 p-1 rounded-xl border border-slate-700 overflow-x-auto max-w-full">
            <button onclick="applyViewPreset('cutaway_all')" id="mode-cutaway_all" class="mode-btn active px-2.5 py-1.5 rounded-lg text-[11px] font-bold text-slate-200 hover:bg-slate-700 transition whitespace-nowrap">
                <i class="fa-solid fa-layer-group mr-1"></i>Écorché RDC + R+1
            </button>
            <button onclick="applyViewPreset('rdc_only')" id="mode-rdc_only" class="mode-btn px-2.5 py-1.5 rounded-lg text-[11px] font-bold text-slate-200 hover:bg-slate-700 transition whitespace-nowrap">
                <i class="fa-solid fa-industry mr-1"></i>RDC & Petit Matériel
            </button>
            <button onclick="applyViewPreset('r1_focus')" id="mode-r1_focus" class="mode-btn px-2.5 py-1.5 rounded-lg text-[11px] font-bold text-slate-200 hover:bg-slate-700 transition whitespace-nowrap">
                <i class="fa-solid fa-stairs mr-1"></i>Étage R+1
            </button>
            <button onclick="applyViewPreset('exterior')" id="mode-exterior" class="mode-btn px-2.5 py-1.5 rounded-lg text-[11px] font-bold text-slate-200 hover:bg-slate-700 transition whitespace-nowrap">
                <i class="fa-solid fa-wheat-awn mr-1 text-amber-400"></i>Corps de Ferme
            </button>
            <button onclick="toggleWalkMode()" id="mode-walk" class="mode-btn px-2.5 py-1.5 rounded-lg text-[11px] font-extrabold bg-emerald-600 text-white hover:bg-emerald-500 border border-emerald-400/60 transition whitespace-nowrap shadow">
                <i class="fa-solid fa-person-walking mr-1"></i>Se promener
            </button>
            <button onclick="toggleDemoTour()" id="mode-demo" class="mode-btn px-3 py-1.5 rounded-lg text-[11px] font-extrabold bg-indigo-600 text-white hover:bg-indigo-500 border border-indigo-400/70 transition whitespace-nowrap shadow">
                <i class="fa-solid fa-film mr-1 text-amber-300"></i>Visite Démo (Grain ➔ Pain)
            </button>
        </div>
    </header>

    <!-- CONTENEUR 3D & INTERFACES FLOTTANTES -->
    <div id="canvas-container">
        <div id="labels-container" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

        <!-- Message d'erreur propre sans alert() si WebGL indisponible -->
        <div id="webgl-error-box" class="hidden absolute inset-0 flex items-center justify-center bg-slate-900/95 text-white p-6 z-50">
            <div class="max-w-md bg-slate-800 border border-red-500/50 rounded-2xl p-5 text-center space-y-2">
                <div class="text-red-400 font-extrabold text-sm">Rendu 3D momentanément indisponible</div>
                <p id="webgl-error-text" class="text-xs text-slate-300"></p>
            </div>
        </div>

        <!-- INTERFACE SCÉNARISÉE COMPACTE EN ANGLE HAUT-GAUCHE (ZÉRO OBSTRUCTION DU CENTRE DE L'ÉCRAN) -->
        <div id="demo-hud" class="hidden absolute top-3 left-3 z-30 pointer-events-none w-[330px] sm:w-[395px] max-w-[calc(100vw-24px)]">
            <div class="bg-slate-900/90 backdrop-blur-md text-white border border-amber-400/60 rounded-2xl shadow-2xl p-3 pointer-events-auto space-y-2">
                <div class="flex items-center justify-between gap-1.5">
                    <span id="demo-step-badge" class="px-2 py-0.5 rounded-full bg-amber-500 text-slate-950 text-[10px] font-extrabold uppercase tracking-wider shrink-0">
                        ÉTAPE 1 / 7
                    </span>
                    <div class="flex items-center gap-1 shrink-0">
                        <button onclick="stepDemoDelta(-1)" class="w-7 h-6 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-[10px] font-bold flex items-center justify-center transition" title="Étape précédente">
                            <i class="fa-solid fa-backward-step"></i>
                        </button>
                        <button onclick="toggleDemoPause()" id="btn-demo-pause" class="px-2.5 h-6 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-[10.5px] font-extrabold flex items-center justify-center transition">
                            <i class="fa-solid fa-pause mr-1"></i>Pause
                        </button>
                        <button onclick="stepDemoDelta(1)" class="w-7 h-6 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-[10px] font-bold flex items-center justify-center transition" title="Étape suivante">
                            <i class="fa-solid fa-forward-step"></i>
                        </button>
                        <button onclick="toggleDemoMinimize()" class="w-7 h-6 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-[10px] text-slate-300 flex items-center justify-center transition" title="Réduire / Déplier le texte">
                            <i id="demo-min-icon" class="fa-solid fa-chevron-up"></i>
                        </button>
                        <button onclick="exitDemoTour()" class="px-2 h-6 rounded-lg bg-red-600 hover:bg-red-500 text-white text-[10.5px] font-extrabold flex items-center justify-center transition" title="Quitter la démo">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <h3 id="demo-step-title" class="text-xs font-extrabold text-amber-300 leading-snug">
                    1. Silos, Nettoyage, Épierrage & Décorticage
                </h3>

                <!-- Barre de progression fine -->
                <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                    <div id="demo-progress-bar" class="h-full bg-gradient-to-r from-amber-400 to-emerald-400 transition-all duration-100" style="width: 0%;"></div>
                </div>

                <!-- Zone repliable pour dégager encore plus la vue -->
                <div id="demo-Hud-collapsible" class="space-y-2">
                    <p id="demo-step-desc" class="text-[11px] text-slate-200 leading-snug"></p>
                    <div class="grid grid-cols-4 gap-1 pt-0.5">
                        <button onclick="setDemoStep(0)" id="dstep-0" class="demo-step-btn active px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">1. Silos</button>
                        <button onclick="setDemoStep(1)" id="dstep-1" class="demo-step-btn px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">2. Manitou</button>
                        <button onclick="setDemoStep(2)" id="dstep-2" class="demo-step-btn px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">3. Moulin</button>
                        <button onclick="setDemoStep(3)" id="dstep-3" class="demo-step-btn px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">4. Pétrins</button>
                        <button onclick="setDemoStep(4)" id="dstep-4" class="demo-step-btn px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">5. Cuisson</button>
                        <button onclick="setDemoStep(5)" id="dstep-5" class="demo-step-btn px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">6. Livraison</button>
                        <button onclick="setDemoStep(6)" id="dstep-6" class="demo-step-btn col-span-2 px-1.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[9.5px] font-semibold text-slate-300 truncate transition">7. Boutique & Clients</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerte douce de collision contre les autres bâtiments non visitables de la ferme -->
        <div id="walk-notice" class="hidden absolute top-24 left-1/2 -translate-x-1/2 z-40 bg-slate-900/95 text-amber-300 border border-amber-400/60 px-3.5 py-1.5 rounded-full text-xs font-bold shadow-xl pointer-events-none">
            <i class="fa-solid fa-lock mr-1.5"></i>Bâtiment privé de l'exploitation agricole (extérieur uniquement — seul le pôle Meunerie / Fournil / Boutique est visitable)
        </div>

        <!-- BANDEAU VISITE À PIED (1re PERSONNE) -->
        <div id="walk-hud" class="hidden absolute inset-x-0 top-3 z-30 pointer-events-none flex flex-col items-center px-3 gap-2">
            <div class="bg-slate-900/95 backdrop-blur-md text-white border border-emerald-400/50 rounded-2xl shadow-2xl px-3.5 py-2 pointer-events-auto flex flex-wrap items-center justify-center gap-2 max-w-[960px]">
                <span class="px-2 py-0.5 rounded-full bg-emerald-500/25 border border-emerald-400/50 text-emerald-300 text-[10.5px] font-extrabold uppercase tracking-wide">
                    <i class="fa-solid fa-street-view mr-1"></i>Visite (<span id="walk-floor-badge">RDC • 0,00 m</span>)
                </span>
                <div class="flex flex-wrap items-center gap-1">
                    <button onclick="teleportWalker('cour')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-amber-300 border border-slate-700 transition">Cour & Auvent</button>
                    <button onclick="teleportWalker('ferme')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-lime-300 border border-slate-700 transition">Cour de Ferme & Silos</button>
                    <button onclick="teleportWalker('boutique')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-emerald-300 border border-slate-700 transition">Boutique</button>
                    <button onclick="teleportWalker('fours')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-red-300 border border-slate-700 transition">Fours</button>
                    <button onclick="teleportWalker('petrins')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-rose-300 border border-slate-700 transition">Pétrins & Façonnage</button>
                    <button onclick="teleportWalker('moulins')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-amber-200 border border-slate-700 transition">Moulins Meules</button>
                    <button onclick="teleportWalker('escalier')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-cyan-300 border border-slate-700 transition">Pied Escalier (3,30m)</button>
                    <button onclick="teleportWalker('r1_palier')" class="px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[10.5px] font-bold text-indigo-300 border border-slate-700 transition">Étage R+1</button>
                </div>
                <button onclick="exitWalkMode()" class="ml-1 px-2.5 py-1 rounded-lg bg-red-600 hover:bg-red-500 text-white text-[11px] font-extrabold transition shadow">
                    <i class="fa-solid fa-xmark mr-1"></i>Quitter
                </button>
            </div>
            <div class="bg-slate-900/80 backdrop-blur text-slate-200 text-[10.5px] px-3 py-1 rounded-full border border-slate-700/80">
                <strong>Clavier :</strong> Flèches ou ZQSD pour marcher (Maj = rapide) • <strong>Souris / Tactile :</strong> Glisser pour regarder autour de soi (marchez sur l'escalier pour monter au R+1 !)
            </div>
        </div>

        <!-- PAVÉ DIRECTIONNEL TACTILE / SOURIS POUR LE MODE VISITE -->
        <div id="walk-dpad" class="hidden absolute bottom-14 right-4 z-30 select-none">
            <div class="bg-slate-900/90 backdrop-blur-md p-2 rounded-2xl border border-slate-700 shadow-2xl grid grid-cols-3 gap-1.5 w-[132px]">
                <div></div>
                <button onmousedown="setPadMove('fwd',true)" onmouseup="setPadMove('fwd',false)" onmouseleave="setPadMove('fwd',false)" ontouchstart="setPadMove('fwd',true)" ontouchend="setPadMove('fwd',false)" class="h-9 rounded-xl bg-slate-800 hover:bg-emerald-600 active:bg-emerald-500 text-white font-bold flex items-center justify-center border border-slate-600">
                    <i class="fa-solid fa-arrow-up"></i>
                </button>
                <div></div>
                <button onmousedown="setPadMove('turnL',true)" onmouseup="setPadMove('turnL',false)" onmouseleave="setPadMove('turnL',false)" ontouchstart="setPadMove('turnL',true)" ontouchend="setPadMove('turnL',false)" class="h-9 rounded-xl bg-slate-800 hover:bg-blue-600 active:bg-blue-500 text-white font-bold flex items-center justify-center border border-slate-600" title="Tourner à gauche">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button onmousedown="setPadMove('back',true)" onmouseup="setPadMove('back',false)" onmouseleave="setPadMove('back',false)" ontouchstart="setPadMove('back',true)" ontouchend="setPadMove('back',false)" class="h-9 rounded-xl bg-slate-800 hover:bg-emerald-600 active:bg-emerald-500 text-white font-bold flex items-center justify-center border border-slate-600">
                    <i class="fa-solid fa-arrow-down"></i>
                </button>
                <button onmousedown="setPadMove('turnR',true)" onmouseup="setPadMove('turnR',false)" onmouseleave="setPadMove('turnR',false)" ontouchstart="setPadMove('turnR',true)" ontouchend="setPadMove('turnR',false)" class="h-9 rounded-xl bg-slate-800 hover:bg-blue-600 active:bg-blue-500 text-white font-bold flex items-center justify-center border border-slate-600" title="Tourner à droite">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>

        <!-- VOLET GAUCHE FLOTTANT : CAMÉRAS & COUPES -->
        <div id="side-controls" class="absolute top-3 left-3 z-20 flex flex-col gap-2 max-w-[270px] sm:max-w-[295px]">
            <div class="bg-white/95 backdrop-blur-md border border-slate-200/90 rounded-2xl shadow-xl p-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-700">
                        <i class="fa-solid fa-video text-blue-600 mr-1"></i>Points de vue rapides
                    </span>
                    <button onclick="toggleControlPanel()" class="text-[11px] text-slate-400 hover:text-slate-700 px-1.5 py-0.5 rounded" title="Réduire/Agrandir">
                        <i id="panel-chevron" class="fa-solid fa-chevron-up"></i>
                    </button>
                </div>

                <div id="panel-collapsible" class="space-y-2.5">
                    <div class="grid grid-cols-2 gap-1.5">
                        <button onclick="flyToCamera('overview')" id="cam-overview" class="cam-btn active px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-bold text-slate-700 text-left transition">
                            <i class="fa-solid fa-globe mr-1 opacity-75"></i>Vue Bâtiment
                        </button>
                        <button onclick="flyToCamera('ferme')" id="cam-ferme" class="cam-btn px-2 py-1.5 rounded-lg border border-slate-200 bg-amber-50 hover:bg-amber-100 text-[11px] font-bold text-amber-900 text-left transition">
                            <i class="fa-solid fa-tractor mr-1"></i>Ferme d'Aubetin
                        </button>
                        <button onclick="flyToCamera('top')" id="cam-top" class="cam-btn px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-bold text-slate-700 text-left transition">
                            <i class="fa-solid fa-border-all mr-1 opacity-75"></i>Vue de Dessus
                        </button>
                        <button onclick="flyToCamera('boutique')" id="cam-boutique" class="cam-btn px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-bold text-emerald-800 text-left transition">
                            <i class="fa-solid fa-store mr-1"></i>Z1 Boutique
                        </button>
                        <button onclick="flyToCamera('fournil')" id="cam-fournil" class="cam-btn px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-bold text-red-800 text-left transition">
                            <i class="fa-solid fa-fire-burner mr-1"></i>Z2–Z4 Fournil
                        </button>
                        <button onclick="flyToCamera('meunerie')" id="cam-meunerie" class="cam-btn px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-bold text-amber-800 text-left transition">
                            <i class="fa-solid fa-wheat-awn mr-1"></i>Z5 Meunerie
                        </button>
                        <button onclick="flyToCamera('escalier')" id="cam-escalier" class="cam-btn col-span-2 px-2 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-bold text-cyan-800 text-left transition">
                            <i class="fa-solid fa-wheelchair mr-1"></i>Escalier Est➔Ouest & Élévateur PMR
                        </button>
                    </div>

                    <div class="pt-2 border-t border-slate-200">
                        <div class="text-[10.5px] font-extrabold uppercase tracking-wider text-slate-500 mb-1.5">
                            Coupes & Calques 3D
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            <button onclick="toggleLowWalls()" id="btn-low-walls" class="layer-pill px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold bg-white hover:bg-slate-100 transition">
                                <i class="fa-solid fa-scissors mr-1 text-amber-500"></i>Murs coupés à 1,35 m
                            </button>
                            <button onclick="toggleLayer3D('farm')" id="btn-layer-farm" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                <i class="fa-solid fa-warehouse mr-1 text-amber-400"></i>Corps de Ferme
                            </button>
                            <button onclick="toggleLayer3D('small')" id="btn-layer-small" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                <i class="fa-solid fa-utensils mr-1 text-sky-400"></i>Petit Matériel
                            </button>
                            <button onclick="toggleLayer3D('r1')" id="btn-layer-r1" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                Étage R+1
                            </button>
                            <button onclick="toggleLayer3D('auvent')" id="btn-layer-auvent" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                Auvent Sud
                            </button>
                            <button onclick="toggleLayer3D('roof')" id="btn-layer-roof" class="layer-pill px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold bg-white hover:bg-slate-100 transition">
                                Toiture
                            </button>
                            <button onclick="toggleLayer3D('ceilings')" id="btn-layer-ceilings" class="layer-pill px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold bg-white hover:bg-slate-100 transition">
                                Plafonds +2,90m
                            </button>
                            <button onclick="toggleLayer3D('networks')" id="btn-layer-networks" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                Caniveaux & CVC
                            </button>
                            <button onclick="toggleLayer3D('staff')" id="btn-layer-staff" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                <i class="fa-solid fa-users mr-1 text-emerald-500"></i>Salarié·e·s
                            </button>
                            <button onclick="toggleLabels()" id="btn-layer-labels" class="layer-pill active px-2.5 py-1 rounded-lg border border-slate-300 text-[11px] font-semibold transition">
                                Étiquettes
                            </button>
                        </div>
                    </div>
                </div>
