        function createStoneTexture() {
            const c = document.createElement('canvas');
            c.width = 256; c.height = 256;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#d6cfc2';
            ctx.fillRect(0, 0, 256, 256);
            const palette = ['#c9beac', '#bfb39f', '#dfd8cb', '#b5a690', '#cfc5b4', '#c2b29b'];
            for (let row = 0; row < 10; row++) {
                const y = row * 26;
                let x = (row % 2) * -18;
                while (x < 256) {
                    const w = 28 + ((x * 13 + row * 7) % 24);
                    ctx.fillStyle = palette[Math.abs(x + row * 3) % palette.length];
                    ctx.fillRect(x + 2, y + 2, w - 3, 21);
                    x += w;
                }
            }
            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(5, 1.6);
            return tex;
        }

        function createTileGridTexture(bgHex, lineHex, repeatX, repeatY) {
            const c = document.createElement('canvas');
            c.width = 128; c.height = 128;
            const ctx = c.getContext('2d');
            ctx.fillStyle = bgHex;
            ctx.fillRect(0, 0, 128, 128);
            ctx.strokeStyle = lineHex;
            ctx.lineWidth = 3;
            ctx.strokeRect(0, 0, 128, 128);
            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(repeatX, repeatY);
            return tex;
        }

        function createRoofTileTexture() {
            const c = document.createElement('canvas');
            c.width = 128; c.height = 128;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#7c3f2c';
            ctx.fillRect(0, 0, 128, 128);
            for (let r = 0; r < 8; r++) {
                ctx.fillStyle = (r % 2 === 0) ? '#8d4833' : '#6f3625';
                ctx.fillRect(0, r * 16, 128, 14);
                ctx.strokeStyle = '#512417';
                ctx.lineWidth = 1.5;
                for (let col = 0; col < 8; col++) {
                    ctx.strokeRect(col * 16 + (r % 2) * 8, r * 16, 16, 16);
                }
            }
            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(22, 6);
            return tex;
        }

        function createWoodCladdingTexture() {
            const c = document.createElement('canvas');
            c.width = 256; c.height = 128;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#4e3626';
            ctx.fillRect(0, 0, 256, 128);
            for (let i = 0; i < 32; i++) {
                ctx.fillStyle = (i % 3 === 0) ? '#3f2b1e' : (i % 2 === 0 ? '#5a3e2c' : '#483222');
                ctx.fillRect(i * 8, 0, 7, 128);
                ctx.fillStyle = '#291c12';
